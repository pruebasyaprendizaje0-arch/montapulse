# ==========================================
# FIREBASE CLIENT CONFIGURATION (FRONTEND)
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_fcm_vapid_key_optional

# ==========================================
# EXTERNAL INTEGRATIONS & APIs
# ==========================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_DLOCAL_GO_SMARTFIELDS_API_KEY=your_dlocal_smartfields_key_here
VITE_RESEND_API_KEY=your_resend_api_key_here

# ==========================================
# BACKEND / SERVER KEYS (DO NOT EXPOSE TO CLIENT)
# ==========================================
PORT=3010
DLOCAL_GO_API_KEY=your_dlocal_api_key_here
DLOCAL_GO_SECRET_KEY=your_dlocal_secret_key_here
RESEND_API_KEY=your_resend_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
