rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== FUNCIONES HELPER ==========
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        (exists(/databases/$(database)/documents/users_v2/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users_v2/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ========== REGLAS DE COLECCIONES ==========

    // Users V2: Solo el dueño o administradores pueden leer.
    // Privilegios protegidos: roles, planes, puntos y cuotas solo modificables por admin/servidor.
    match /users_v2/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        isAdmin() ||
        (
          (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'visitor' || request.resource.data.role == 'host') &&
          (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'Free') &&
          !request.resource.data.keys().hasAny(['points', 'subscriptionEndDate', 'paymentStatus', 'monthlyEventCount', 'monthlyAnnouncementCount', 'lastEventResetDate', 'lastAnnouncementResetDate'])
        )
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'plan', 'points', 'subscriptionEndDate', 'paymentStatus', 
          'monthlyEventCount', 'monthlyAnnouncementCount', 'lastEventResetDate', 'lastAnnouncementResetDate'
        ])
      );
      allow delete: if isAdmin();
    }
    
    // Negocios: Público read.
    // Propietario no puede transferir ownerId ni alterar métricas, plan, créditos o verificación directamente.
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.keys().hasAll(['name', 'category']) &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 100 &&
                    request.resource.data.category is string &&
                    (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'Free') &&
                    !request.resource.data.keys().hasAny(['viewCount', 'monthlyViews', 'lastMonthlyResetDate', 'eventCredits', 'isVerified']);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'viewCount', 'monthlyViews', 'lastMonthlyResetDate', 'eventCredits', 'plan', 'isVerified'
        ])
      );
      allow delete: if isAdmin();

      // Menú digital subcollections
      match /menu_categories/{catId} {
        allow read: if true;
        allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid);
      }
      match /menu_products/{prodId} {
        allow read: if true;
        allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid);
      }
    }
    
    // Eventos: Público read.
    // Inmutabilidad de ownerId, validación de fechas/estados y protección de métricas de vista/clicks.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.keys().hasAll(['title', 'startAt']) &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.title.size() <= 120 &&
                    request.resource.data.startAt is timestamp &&
                    (!request.resource.data.keys().hasAny(['endAt']) || request.resource.data.endAt is timestamp) &&
                    (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['draft', 'published', 'confirmed', 'cancelled', 'expired', 'active', 'readonly', 'deactivated']) &&
                    !request.resource.data.keys().hasAny(['viewCount', 'clickCount', 'monthlyViews', 'weeklyClicks', 'interestedCount']);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount', 'clickCount', 'monthlyViews', 'weeklyClicks', 'interestedCount']) &&
        (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['draft', 'published', 'confirmed', 'cancelled', 'expired', 'active', 'readonly', 'deactivated'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }
    
    // Comunidad: Público read, autor no transferible, límite razonable de contenido
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.content is string &&
                    request.resource.data.content.size() <= 2000;
      allow update: if isAdmin() || 
                    (isAuthenticated() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId) ||
                    (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount']));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Anuncios: Público read
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.senderId == request.auth.uid &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    // RSVPs: Público read para conteos, Auth write para su propio UID
    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.eventId is string;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Chat Global (Pulso Global): Público read
    match /pulso_global/{msgId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // Chat Privado: Participantes autenticados; lista de participantes inmutable para usuarios regulares
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && 
                    request.auth.uid in request.resource.data.participants &&
                    request.resource.data.participants.size() <= 50;
      allow update: if isAuthenticated() && 
                    (request.auth.uid in resource.data.participants || isAdmin()) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isAuthenticated() && 
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() <= 2000;
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
      }
    }

    // Reseñas: Público read
    match /businessReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.rating is number &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Localidades: Público read
    match /customLocalities/{localityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Seguidores: Público read
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Favoritos: Privado
    match /favorites/{favId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notificaciones: Privado.
    // Los usuarios autenticados NO pueden enviar notificaciones a terceros desde el cliente.
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Puntos y Vales: Solo administradores / servidor pueden crear o alterar puntos y vales.
    match /points/{pointId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Registro de visitas: Gestionado exclusivamente por backend/admin
    match /registro_visitas/{visitId} {
      allow read, write: if isAdmin();
    }

    // Ajustes: Público read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cupones: Público read, owner/admin manage. Clientes no pueden alterar currentUses directamente.
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    (request.resource.data.ownerId == request.auth.uid || isAdmin()) &&
                    request.resource.data.code is string &&
                    request.resource.data.code.size() <= 30 &&
                    request.resource.data.value is number &&
                    request.resource.data.value > 0;
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentUses'])
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Redenciones de cupones: Auth read/create, validación de estados y partes autorizadas
    match /couponRedemptions/{redemptionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.couponId is string &&
                    request.resource.data.status == 'reserved';
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'cancelled' || request.resource.data.status == 'expired')
      );
      allow delete: if isAdmin();
    }
    
    // Solicitudes de pago y Órdenes de pago (dLocal Go / Transferencia Bancaria):
    // - Creación: Usuario autenticado con su propio UID y estado 'pendiente'/'pending'
    // - Lectura: El propio usuario o administradores
    // - Actualización: Solo administradores / servidor
    // - Borrado: Bloqueado para todos (auditoría contable inmutable)
    match /payment_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.estado == 'pendiente';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payment_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Historial contable de transacciones: Inmutable
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Boosts: Privado read/create
    match /boosts/{boostId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Master data: Público read, Admin write
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /vibes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sectors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /activities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: Solo Admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}